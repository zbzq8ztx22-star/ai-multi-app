# OpenExecutive API endpoint. The development default runs OpenExecutive on port 8000.
OPENEXECUTIVE_API_URL=http://localhost:8000

# Authentication shared with OpenExecutive.
# Set this to the exact same private value as BACKEND_SHARED_SECRET in OpenExecutive.
# Generate and store a real secret locally; do not commit it.
OPENEXECUTIVE_API_KEY=

# Flask session secret key. Generate a long random string and keep it private.
SECRET_KEY=change-me-in-production

# Optional: create an admin user on startup with this password.
DEFAULT_ADMIN_PASSWORD=
